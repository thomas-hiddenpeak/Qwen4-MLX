+// Tiny host-created SSM payloads exercise the real commit ownership and byte
+// accounting paths without model weights or GPU evaluation.
+fn pcBudgetCheckpoint(pos: usize, value: f32) ![]SSMCheckpoint {
+    const layers = try testing.allocator.alloc(transformer_mod.SSMCacheEntrySnapshot, 1);
+    errdefer testing.allocator.free(layers);
+    const data: [8]f32 = @splat(value);
+    layers[0] = .{
+        .conv_state = mlx.mlx_array_new_data(&data, &[_]c_int{8}, 1, .float32),
+        .ssm_state = mlx.mlx_array_new(),
+        .initialized = true,
+    };
+    errdefer {
+        _ = mlx.mlx_array_free(layers[0].conv_state);
+        _ = mlx.mlx_array_free(layers[0].ssm_state);
+    }
+    const cps = try testing.allocator.alloc(SSMCheckpoint, 1);
+    cps[0] = .{ .pos = pos, .layers = layers };
+    return cps;
+}
