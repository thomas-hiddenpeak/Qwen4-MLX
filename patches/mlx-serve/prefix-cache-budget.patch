+test "HotPrefixCache: prefix extension rejects oversized inherited checkpoints without losing old entry" {
+    var source = try KVCache.init(testing.allocator, 0);
+    defer source.deinit();
+    var hc = HotPrefixCache.initWithMem(testing.allocator, 4, 48);
+    defer hc.deinit();
+    const ids = [_]u32{ 1, 2, 3, 4, 5 };
+    try hc.commitWithSsm(&source, ids[0..3], false, try pcBudgetCheckpoint(2, 1.0), null, null);
+    try testing.expectEqual(@as(u64, 32), hc.current_kv_bytes);
+    // New payload is 32 bytes and fits alone; inherited old state makes the
+    // replacement 64 bytes. The old implementation admitted that oversize.
+    try hc.commitWithSsm(&source, &ids, false, try pcBudgetCheckpoint(4, 2.0), null, null);
+    try testing.expectEqual(@as(usize, 1), hc.entryCount());
+    try testing.expectEqual(@as(u64, 32), hc.current_kv_bytes);
+    try testing.expectEqualSlices(u32, ids[0..3], hc.entries.items[0].tokens);
+    try testing.expectEqual(@as(usize, 2), hc.entries.items[0].ssm_checkpoints.?[0].pos);
+    // Same-position replacement does not double-bill inherited state.
+    try hc.commitWithSsm(&source, &ids, false, try pcBudgetCheckpoint(2, 3.0), null, null);
+    try testing.expectEqual(@as(u64, 32), hc.current_kv_bytes);
+    try testing.expectEqualSlices(u32, &ids, hc.entries.items[0].tokens);
+    try testing.expectEqual(@as(usize, 1), hc.entries.items[0].ssm_checkpoints.?.len);
+}
+
+test "HotPrefixCache: prefix extension evicts older entries when aggregate bytes grow" {
+    var source = try KVCache.init(testing.allocator, 0);
+    defer source.deinit();
+    var hc = HotPrefixCache.initWithMem(testing.allocator, 4, 80);
+    defer hc.deinit();
+    const ids = [_]u32{ 1, 2, 3, 4, 5 };
+    const other = [_]u32{ 8, 9, 10 };
+    try hc.commitWithSsm(&source, &other, false, try pcBudgetCheckpoint(2, 2.0), null, null);
+    try hc.commitWithSsm(&source, ids[0..3], false, try pcBudgetCheckpoint(2, 1.0), null, null);
+    try testing.expectEqual(@as(u64, 64), hc.current_kv_bytes);
+    // The extended entry fits at 64 bytes; keeping the other entry would
+    // consume 96 bytes. LRU removal can swap the replaced entry's location.
+    try hc.commitWithSsm(&source, &ids, false, try pcBudgetCheckpoint(4, 3.0), null, null);
+    try testing.expectEqual(@as(usize, 1), hc.entryCount());
+    try testing.expectEqual(@as(u64, 64), hc.current_kv_bytes);
+    try testing.expectEqualSlices(u32, &ids, hc.entries.items[0].tokens);
+    try testing.expectEqual(@as(usize, 2), hc.entries.items[0].ssm_checkpoints.?.len);
+    try testing.expect(hc.findBestMatch(&other, false, 0, kv_quant.KVQuantConfig.dense) == null);
+}
