+test "HotPrefixCache: prefix extension allocation failures preserve caller and old checkpoint ownership" {
+    // Zero-layer snapshots allocate through `source.allocator`, not the hot
+    // cache's failing allocator. Its first request allocation is the token
+    // copy; its second is the exact merged-checkpoint reservation.
+    for ([_]usize{ 0, 1 }) |fail_index| {
+        var source = try KVCache.init(testing.allocator, 0);
+        defer source.deinit();
+        var hc = HotPrefixCache.initWithMem(testing.allocator, 4, 128);
+        defer hc.deinit();
+        const ids = [_]u32{ 1, 2, 3, 4, 5 };
+        try hc.commitWithSsm(&source, ids[0..3], false, try pcBudgetCheckpoint(2, 1.0), null, null);
+        const old_cps = hc.entries.items[0].ssm_checkpoints.?;
+        const old_layers = old_cps[0].layers;
+        const incoming = try pcBudgetCheckpoint(4, 2.0);
+        // This models the scheduler's error cleanup. The test allocator would
+        // catch a double-free if commit released the incoming payload too.
+        defer {
+            for (incoming) |*cp| cp.deinit(testing.allocator);
+            testing.allocator.free(incoming);
+        }
+        var failing = testing.FailingAllocator.init(testing.allocator, .{ .fail_index = fail_index });
+        hc.allocator = failing.allocator();
+        defer hc.allocator = testing.allocator;
+        try testing.expectError(error.OutOfMemory, hc.commitWithSsm(&source, &ids, false, incoming, null, null));
+        try testing.expect(failing.has_induced_failure);
+        try testing.expectEqual(fail_index, failing.alloc_index);
+        try testing.expectEqual(failing.allocated_bytes, failing.freed_bytes);
+        try testing.expectEqual(@as(usize, 1), hc.entryCount());
+        try testing.expectEqual(@as(u64, 32), hc.current_kv_bytes);
+        try testing.expectEqualSlices(u32, ids[0..3], hc.entries.items[0].tokens);
+        const retained = hc.entries.items[0].ssm_checkpoints.?;
+        try testing.expect(retained.ptr == old_cps.ptr);
+        try testing.expect(retained[0].layers.ptr == old_layers.ptr);
+        try testing.expectEqual(@as(usize, 2), retained[0].pos);
+        try testing.expectEqual(@as(u64, 32), ssmCheckpointBytes(&retained[0]));
+        try testing.expectEqual(@as(usize, 4), incoming[0].pos);
+        try testing.expectEqual(@as(u64, 32), ssmCheckpointBytes(&incoming[0]));
+    }
+}
